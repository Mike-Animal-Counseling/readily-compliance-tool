# Generate TWO DIFFERENT random secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEMO_ACCESS_CODE=
SESSION_SECRET=
APP_ORIGIN=http://localhost:3000
# Required TLS Redis in production; bounded shared jobs/datasets and budgets.
REDIS_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_EXTRACT_MODEL=openai/gpt-4.1-mini
OPENROUTER_REVIEW_MODEL=openai/gpt-4.1-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1536
AUDIT_EXTRACTION_BATCH_SIZE=3
AUDIT_EXTRACTION_MAX_TOKENS=1200
AUDIT_EXTRACTION_TIMEOUT_MS=10000
EVALUATION_CONCURRENCY=3
EVALUATION_LLM_TIMEOUT_MS=20000
RETRIEVAL_VECTOR_WEIGHT=3
PRELOADED_LEXICAL_WEIGHT=1
PRELOADED_VECTOR_WEIGHT=0.35
DATABASE_URL=
READILY_V1_ENABLED=false
# PostgreSQL/pgvector runtime connection for the third-party API. Use sslmode=verify-full in production.
READILY_V1_DATABASE_URL=
# Optional same-host OCR worker for v1 scanned policies. Use a separate random token.
READILY_V1_OCR_PORT=
READILY_V1_OCR_TOKEN=

# Optional same-host cross-encoder with a pinned model alias and independent random bearer token.
READILY_V1_RERANK_PORT=
READILY_V1_RERANK_TOKEN=
READILY_V1_RERANK_MODEL=
